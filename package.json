{
  "name": "react-native-nitro-health",
  "version": "0.1.0",
  "description": "react-native-nitro-health is a react native package built with Nitro",
  "keywords": [
    "react-native",
    "react-native-nitro-health"
  ],
  "homepage": "https://github.com/adrianwhite/react-native-nitro-health#readme",
  "bugs": "https://github.com/adrianwhite/react-native-nitro-health/issues",
  "license": "MIT",
  "author": "Adrian White",
  "repository": "https://github.com/adrianwhite/react-native-nitro-health.git",
  "source": "src/index",
  "workspaces": [
    "example"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun run --cwd example test",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "bun run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && bun run build && node post-script.js"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "nitrogen": "0.35.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.35.5",
    "semantic-release": "^25.0.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
