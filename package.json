{
  "name": "react-native-nitro-health",
  "version": "0.1.0",
  "description": "react-native-nitro-health is a react native package built with Nitro",
  "keywords": [
    "react-native",
    "react-native-nitro-health"
  ],
  "homepage": "https://github.com/AdrianCD101/react-native-nitro-health#readme",
  "bugs": "https://github.com/AdrianCD101/react-native-nitro-health/issues",
  "license": "MIT",
  "author": "Adrian White",
  "repository": "https://github.com/AdrianCD101/react-native-nitro-health.git",
  "source": "src/index",
  "workspaces": [
    "example"
  ],
  "files": [
    "src",
    "jest",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md",
    "!android/src/test",
    "!ios/Tests"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./jest/mock": {
      "types": "./jest/mock.d.ts",
      "default": "./jest/mock.js"
    },
    "./jest/setup": {
      "types": "./jest/setup.d.ts",
      "default": "./jest/setup.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "harness:android": "bun run --cwd example harness:android",
    "harness:ios": "bun run --cwd example harness:ios",
    "test": "bun run --cwd example test",
    "test:android:native": "example/android/gradlew -p example/android :react-native-nitro-health:testDebugUnitTest",
    "test:ios:native": "swift test",
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc -p example",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "node verify-codegen.js && bun run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && node post-script.js && bun run build"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.15",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "nitrogen": "^0.36.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react": "19.2.6",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.36.1",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
