@@ -522,0 +523,62 @@ const deleteDefaultsValue = async (
+const ACCESSIBILITY_DEFAULTS_DOMAIN = 'com.apple.Accessibility';
+const REDUCE_MOTION_DEFAULTS_KEY = 'ReduceMotionEnabled';
+
+const writeDefaultsBoolean = async (
+  udid: string,
+  bundleId: string,
+  key: string,
+  value: boolean,
+): Promise<void> => {
+  await spawn('xcrun', [
+    'simctl',
+    'spawn',
+    udid,
+    'defaults',
+    'write',
+    bundleId,
+    key,
+    '-bool',
+    value ? 'YES' : 'NO',
+  ]);
+};
+
+export const applyReduceMotionOverride = async (
+  udid: string,
+): Promise<boolean | null> => {
+  const existingValue = await getDefaultsValue(
+    udid,
+    ACCESSIBILITY_DEFAULTS_DOMAIN,
+    REDUCE_MOTION_DEFAULTS_KEY,
+  );
+
+  await writeDefaultsBoolean(
+    udid,
+    ACCESSIBILITY_DEFAULTS_DOMAIN,
+    REDUCE_MOTION_DEFAULTS_KEY,
+    true,
+  );
+
+  return existingValue === null ? null : existingValue === '1';
+};
+
+export const clearReduceMotionOverride = async (
+  udid: string,
+  previousValue: boolean | null,
+): Promise<void> => {
+  if (previousValue === null) {
+    await deleteDefaultsValue(
+      udid,
+      ACCESSIBILITY_DEFAULTS_DOMAIN,
+      REDUCE_MOTION_DEFAULTS_KEY,
+    );
+    return;
+  }
+
+  await writeDefaultsBoolean(
+    udid,
+    ACCESSIBILITY_DEFAULTS_DOMAIN,
+    REDUCE_MOTION_DEFAULTS_KEY,
+    previousValue,
+  );
+};
+
